{% extends 'base.html.twig' %}

{% block title %}
    {{ 'ship.list.title'|trans }}
{% endblock title %}

{% block body %}
    <article>
        <h1 class="mb-4">{{ 'ship.list.title'|trans }}</h1>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">{{ 'ship.list.label_name'|trans }}</th>
                    <th scope="col">{{ 'ship.list.label_class'|trans }}</th>
                    <th scope="col">{{ 'ship.list.label_hull_status'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% set hullVariant = {"intact": "success", "damaged": "warning", "destroyed": "danger"} %}
                {% for ship in ships %}
                    <tr>
                        <th scope="row">
                            {% if ship.name is not null %}
                                {{ ship.name }}
                            {% else %}
                                <span class="text-body-secondary fst-italic">{{ 'ship.not_christened'|trans }}</span>
                            {% endif %}
                        </th>

                        <td>
                            {{ ('ship.class.'~ship.class.value)|trans }}
                        </td>
                        <td>
                            <span class="badge text-bg-{{ hullVariant[ship.hullStatus.value] }}">{{ ('ship.hull_status.'~ship.hullStatus.value)|trans }}</span>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center text-body-secondary">
                            {{ 'ship.list.empty'|trans }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </article>
{% endblock body %}
