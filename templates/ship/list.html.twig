{% extends 'base.html.twig' %}

{% block title %}
    {{ 'ship.list.title'|trans }}
{% endblock title %}

{% block body %}
    <article>
        <h1>{{ 'ship.list.title'|trans }}</h1>
        <table>
            <thead>
            <tr>
                <th>{{ 'ship.list.label_name'|trans }}</th>
                <th>{{ 'ship.list.label_class'|trans }}</th>
                <th>{{ 'ship.list.label_hull_status'|trans }}</th>
            </tr>
            </thead>
            <tbody>
                {% for ship in ships %}
                    <tr>
                        <td>{{ ship.name|default('—') }}</td>
                        <td>{{ ship.class.value }}</td>
                        <td class="hull--{{ ship.hullStatus.value }}">{{ ('ship.hull_status.'~ship.hullStatus.value)|trans }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">{{ 'ship.list.empty'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </article>
{% endblock body %}
